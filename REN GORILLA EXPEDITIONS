        <div class="glass-panel gold-border-glow max-w-3xl w-full max-h-[90vh] overflow-y-auto rounded-sm p-6 sm:p-8 relative">
            <button type="button" 
                    onclick="closeExpeditionModal()" 
                    class="absolute top-4 right-4 text-gray-400 hover:text-gold text-2xl p-2 focus:outline-none"
                    aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <div id="modal-content-body">
                <!-- Dynamic Content Injected via JavaScript -->
            </div>
        </div>
    </div>

    <div id="gallery-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/90 backdrop-blur-lg" onclick="closeGalleryModal()">
        <div class="relative max-w-5xl w-full text-center" onclick="event.stopPropagation()">
            <button type="button" 
                    onclick="closeGalleryModal()" 
                    class="absolute -top-12 right-0 text-gold hover:text-white text-3xl font-bold p-2 focus:outline-none"
                    aria-label="Close Lightbox">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <img id="lightbox-img" src="" alt="" class="max-h-[80vh] mx-auto rounded-sm border border-gold/30 shadow-2xl object-contain">
            <p id="lightbox-caption" class="text-gold font-heading text-sm uppercase tracking-widest mt-4"></p>
        </div>
    </div>

    <script>
        // Set current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Navigation Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        mobileMenuBtn.addEventListener('click', () => {
            const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
            mobileMenuBtn.setAttribute('aria-expanded', !isExpanded);
            mobileMenu.classList.toggle('hidden');
            menuIcon.classList.toggle('fa-bars');
            menuIcon.classList.toggle('fa-xmark');
        });

        // Close mobile menu on click link
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                mobileMenuBtn.setAttribute('aria-expanded', 'false');
                menuIcon.classList.add('fa-bars');
                menuIcon.classList.remove('fa-xmark');
            });
        });

        // Expedition Filter Buttons Logic
        const filterBtns = document.querySelectorAll('.filter-btn');
        const expeditionCards = document.querySelectorAll('.expedition-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-gold', 'text-obsidian', 'font-bold');
                    b.classList.add('glass-panel', 'text-gray-300');
                });
                btn.classList.add('bg-gold', 'text-obsidian', 'font-bold');
                btn.classList.remove('glass-panel', 'text-gray-300');

                const filter = btn.getAttribute('data-filter');

                expeditionCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Floating WhatsApp Popup Toggle
        function toggleWhatsAppPopup() {
            const popup = document.getElementById('whatsapp-popup');
            popup.classList.toggle('hidden');
        }

        // Detailed Expedition Data Store
        const expeditionData = {
            'gorilla-odyssey': {
                title: "Gorilla Habituation Luxury Odyssey",
                subtitle: "Bwindi Impenetrable Forest | 5 Days / 4 Nights",
                image: "https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1200&q=85",
                description: "Unlike standard 1-hour gorilla tracking, this exclusive expedition grants 4 full hours alongside researchers and trackers during gorilla habituation in Bwindi's southern sector.",
                highlights: [
                    "Private domestic chartered aircraft directly into Kihihi/Kisoro airstrip",
                    "4 hours face-to-face with wild gorilla families during habituation",
                    "5-Star luxury sanctuary accommodation with personal butler",
                    "Guided Batwa community cultural walk & ancient forest heritage experience"
                ],
                waText: "Hello! I am interested in booking the 5-Day Gorilla Habituation Luxury Odyssey."
            },
            'lion-safari': {
                title: "Tree-Climbing Lions & Savanna Predators",
                subtitle: "Queen Elizabeth NP & Ishasha Sector | 7 Days / 6 Nights",
                image: "https://images.unsplash.com/photo-1546182990-dffeafbe841d?auto=format&fit=crop&w=1200&q=85",
                description: "Delve deep into Queen Elizabeth National Park. Witness rare tree-climbing lions resting in colossal fig trees and glide down the Kazinga Channel on a private luxury pontoon.",
                highlights: [
                    "Tree-climbing lion tracking in Ishasha wilderness",
                    "Private VIP lounge deck cruise along Kazinga Channel",
                    "Chimpanzee trekking in Kyambura Gorge underground rainforest",
                    "Night game drives with thermal optics and predator research trackers"
                ],
                waText: "Hello! I am inquiring about the 7-Day Tree-Climbing Lions & Savanna Safari."
            },
            'elephant-safari': {
                title: "Mighty Elephants & Nile Cascades",
                subtitle: "Murchison Falls National Park | 6 Days / 5 Nights",
                image: "https://images.unsplash.com/photo-1557050543-4d5f4e07ef46?auto=format&fit=crop&w=1200&q=85",
                description: "Experience the sheer power of the Nile squeezing through a 7-meter gorge alongside thousands of wild African elephants migrating across savanna corridors.",
                highlights: [
                    "Helicopter flyover over the apex of Murchison Falls",
                    "Private river charter to the base of the roaring Nile cascades",
                    "On-foot Ziwa Rhino Sanctuary tracking experience",
                    "Sunset luxury champagne sundowners on the Nile delta"
                ],
                waText: "Hello! I want to request details for the 6-Day Mighty Elephants & Nile Safari."
            },
            'grand-circuit': {
                title: "The Great African Ultra-Luxury Circuit",
                subtitle: "12 Days / 11 Nights | Flagship Uganda Masterpiece",
                image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=85",
                description: "The ultimate East African journey combining every iconic ecosystem: Bwindi Gorillas, Kibale Chimpanzees, Queen Elizabeth Lions, and Murchison Elephants connected by luxury bush flights.",
                highlights: [
                    "All domestic flight transfers in luxury private turboprops",
                    "Gorilla habituation permit + Chimpanzee trekking permits",
                    "Private 4x4 Land Cruiser with master wildlife guide",
                    "All-inclusive stays at East Africa's top eco-sanctuary lodges"
                ],
                waText: "Hello! I wish to reserve the flagship 12-Day Great African Ultra-Luxury Circuit."
            }
        };

        // Open Expedition Itinerary Modal
        function openExpeditionModal(key) {
            const data = expeditionData[key];
            if (!data) return;

            const modalBody = document.getElementById('modal-content-body');
            const waLink = `https://wa.me/256777990562?text=${encodeURIComponent(data.waText)}`;

            modalBody.innerHTML = `
                <div class="relative h-64 rounded-sm overflow-hidden mb-6 border border-gold/30">
                    <img src="${data.image}" alt="${data.title}" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4">
                        <span class="text-xs uppercase tracking-widest text-gold font-bold">${data.subtitle}</span>
                        <h3 class="text-2xl font-bold text-white font-heading">${data.title}</h3>
                    </div>
                </div>

                <p class="text-gray-300 text-sm leading-relaxed mb-6">${data.description}</p>

                <div class="mb-6 bg-surface p-5 rounded-sm border border-gold/20">
                    <h4 class="text-gold font-heading text-xs uppercase tracking-widest mb-3 font-bold">Key Included Luxuries:</h4>
                    <ul class="space-y-2 text-xs text-gray-300">
                        ${data.highlights.map(h => `<li class="flex items-center gap-2"><i class="fa-solid fa-star text-gold text-[10px]"></i> ${h}</li>`).join('')}
                    </ul>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-2">
                    <a href="${waLink}" target="_blank" rel="noopener noreferrer" 
                       class="flex-1 py-3.5 bg-gold text-obsidian font-bold text-xs uppercase tracking-widest text-center hover:bg-gold-light transition-colors flex items-center justify-center gap-2">
                        <i class="fa-brands fa-whatsapp text-lg"></i>
                        <span>Reserve on WhatsApp (+256 777990562)</span>
                    </a>
                    <a href="#reserve" onclick="closeExpeditionModal()" 
                       class="py-3.5 px-6 glass-panel border border-gold/40 text-gold font-bold text-xs uppercase tracking-widest text-center hover:text-white transition-colors">
                        Custom Inquiry Form
                    </a>
                </div>
            `;

            document.getElementById('expedition-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeExpeditionModal() {
            document.getElementById('expedition-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Lightbox Gallery Functions
        function openGalleryModal(src, caption) {
            document.getElementById('lightbox-img').src = src;
            document.getElementById('lightbox-caption').textContent = caption;
            document.getElementById('gallery-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeGalleryModal() {
            document.getElementById('gallery-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Form Submit Handler -> Redirects dynamically formatted query to WhatsApp!
        function handleFormSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('guest-name').value;
            const email = document.getElementById('guest-email').value;
            const expedition = document.getElementById('expedition-select').value;
            const guests = document.getElementById('guest-count').value;
            const date = document.getElementById('travel-date').value || 'To Be Confirmed';
            const lodging = document.getElementById('luxury-level').value;
            const notes = document.getElementById('special-requests').value || 'None';

            const message = `*REN GORILLA EXPEDITIONS INQUIRY*\n` +
                            `------------------------------------\n` +
                            `*Guest Name:* ${name}\n` +
                            `*Email:* ${email}\n` +
                            `*Expedition:* ${expedition}\n` +
                            `*Group Size:* ${guests}\n` +
                            `*Preferred Date:* ${date}\n` +
                            `*Accommodation:* ${lodging}\n` +
                            `*Notes:* ${notes}\n` +
                            `------------------------------------\n` +
                            `Hello REN Concierge, I would like to check availability for this trip.`;

            const encodedWaUrl = `https://wa.me/256777990562?text=${encodeURIComponent(message)}`;
            
            // Open directly in WhatsApp
            window.open(encodedWaUrl, '_blank');
        }

        // Live updating WhatsApp preview text
        const formInputs = ['guest-name', 'expedition-select', 'guest-count'];
        formInputs.forEach(id => {
            const el = document.getElementById(id);
            if(el) {
                el.addEventListener('input', updateWaPreview);
            }
        });

        function updateWaPreview() {
            const name = document.getElementById('guest-name').value || '[Guest Name]';
            const exp = document.getElementById('expedition-select').value;
            const previewText = `WhatsApp Message: "Hello REN! Inquiry for ${name} regarding ${exp}..."`;
            document.getElementById('whatsapp-preview-text').textContent = previewText;
        }

        // Close Modals on ESC Key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeExpeditionModal();
                closeGalleryModal();
            }
        });
    </script>
</body>
</html>
